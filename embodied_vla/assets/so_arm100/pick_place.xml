<mujoco model="SO-ARM100 language pick-place">
  <include file="so_arm100.xml"/>

  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81">
    <flag contact="enable"/>
  </option>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.25 0.25 0.25" specular="0.1 0.1 0.1"/>
    <global offwidth="256" offheight="256"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient"
      rgb1="0.50 0.62 0.72" rgb2="0.94 0.96 0.98" width="256" height="1536"/>
    <texture name="table_tex" type="2d" builtin="checker" mark="edge"
      rgb1="0.28 0.31 0.34" rgb2="0.36 0.39 0.42" markrgb="0.08 0.08 0.08"
      width="256" height="256"/>
    <material name="table_mat" texture="table_tex" texrepeat="4 4" texuniform="true"
      roughness="0.8"/>
    <material name="red_mat" rgba="0.80 0.08 0.06 1" roughness="0.65"/>
    <material name="green_mat" rgba="0.05 0.58 0.23 1" roughness="0.65"/>
    <material name="blue_mat" rgba="0.04 0.25 0.82 1" roughness="0.65"/>
    <material name="left_goal_mat" rgba="0.95 0.72 0.08 0.45"/>
    <material name="right_goal_mat" rgba="0.68 0.14 0.76 0.45"/>
  </asset>

  <default>
    <default class="task_cube">
      <geom type="box" size="0.015 0.015 0.015" mass="0.025"
        friction="1.3 0.01 0.001" solref="0.008 1" solimp="0.95 0.99 0.001"/>
    </default>
  </default>

  <worldbody>
    <light name="key_light" pos="-0.25 -0.20 0.65" dir="0.3 -0.1 -1"
      directional="true" diffuse="0.75 0.72 0.68"/>
    <light name="fill_light" pos="0.35 -0.45 0.45" dir="-0.4 0.3 -0.8"
      directional="true" diffuse="0.35 0.40 0.48"/>
    <camera name="front" pos="0 -0.72 0.53" xyaxes="1 0 0 0 0.69 0.724"
      fovy="52"/>
    <camera name="wrist_view" pos="0 -0.45 0.20" xyaxes="1 0 0 0 0.45 0.89"
      fovy="55"/>

    <geom name="floor" type="plane" size="1 1 0.05" pos="0 0 -0.036"
      rgba="0.12 0.14 0.16 1" friction="1 0.005 0.0001"/>
    <geom name="table" type="box" size="0.29 0.22 0.015" pos="0 -0.275 -0.015"
      material="table_mat" friction="1.2 0.01 0.001"/>

    <geom name="left_goal" type="cylinder" size="0.052 0.0015"
      pos="-0.11 -0.32 0.002" material="left_goal_mat" contype="0" conaffinity="0"/>
    <geom name="right_goal" type="cylinder" size="0.052 0.0015"
      pos="0.11 -0.32 0.002" material="right_goal_mat" contype="0" conaffinity="0"/>
    <site name="left_goal_site" type="cylinder" size="0.045 0.002"
      pos="-0.11 -0.32 0.004" rgba="0.95 0.72 0.08 0.3"/>
    <site name="right_goal_site" type="cylinder" size="0.045 0.002"
      pos="0.11 -0.32 0.004" rgba="0.68 0.14 0.76 0.3"/>

    <body name="red_cube" pos="-0.09 -0.22 0.022">
      <freejoint name="red_cube_joint"/>
      <geom name="red_cube_geom" class="task_cube" material="red_mat"/>
    </body>
    <body name="green_cube" pos="0 -0.23 0.022">
      <freejoint name="green_cube_joint"/>
      <geom name="green_cube_geom" class="task_cube" material="green_mat"/>
    </body>
    <body name="blue_cube" pos="0.09 -0.22 0.022">
      <freejoint name="blue_cube_joint"/>
      <geom name="blue_cube_geom" class="task_cube" material="blue_mat"/>
    </body>
  </worldbody>

  <equality>
    <weld name="assist_red" body1="grasp_anchor" body2="red_cube"
      relpose="0 0 0 1 0 0 0" active="false" solref="0.02 1"/>
    <weld name="assist_green" body1="grasp_anchor" body2="green_cube"
      relpose="0 0 0 1 0 0 0" active="false" solref="0.02 1"/>
    <weld name="assist_blue" body1="grasp_anchor" body2="blue_cube"
      relpose="0 0 0 1 0 0 0" active="false" solref="0.02 1"/>
  </equality>
</mujoco>
